<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Royal Mithila Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A0505"
                android:centerColor="#3B0D11"
                android:endColor="#0D1B2A" />
        </shape>
    </item>
    <!-- Outer Golden Mithila Frame -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#F4B41A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Inner Crimson & Saffron Traditional Border -->
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#18080A" />
            <stroke android:width="2dp" android:color="#E63946" android:dashWidth="12dp" android:dashGap="6dp" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
