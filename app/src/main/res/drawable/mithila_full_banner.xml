<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A0505"
                android:centerColor="#4A0E14"
                android:endColor="#0D1B2A" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#F4B41A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#22090C" />
            <stroke android:width="2dp" android:color="#E63946" android:dashWidth="12dp" android:dashGap="6dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
